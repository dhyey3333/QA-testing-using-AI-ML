[Unit]
Description=Nightshift hosted: AI QA runs for a QA agency's clients
After=network-online.target ollama.service
Wants=network-online.target

[Service]
User=nightshift
WorkingDirectory=/opt/nightshift
# Nightly times are in this time zone.
Environment=TZ=Asia/Kolkata
Environment=PYTHONIOENCODING=utf-8
# PUBLIC_URL and the MODEL_* settings (setup.sh writes it).
EnvironmentFile=/etc/nightshift.env
ExecStart=/opt/nightshift/.venv/bin/nightshift hosted serve --data /var/lib/nightshift --host 127.0.0.1 --port 8080 --public-url ${PUBLIC_URL} --max-runs 2 --parallel 2
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/nightshift /opt/nightshift

[Install]
WantedBy=multi-user.target
